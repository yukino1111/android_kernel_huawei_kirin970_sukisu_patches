diff --git a/include/linux/susfs_ksu_compat.h b/include/linux/susfs_ksu_compat.h
new file mode 100644
index 000000000..a085cd562
--- /dev/null
+++ b/include/linux/susfs_ksu_compat.h
@@ -0,0 +1,202 @@
+#ifndef KSU_SUSFS_KSU_COMPAT_H
+#define KSU_SUSFS_KSU_COMPAT_H
+
+/*
+ * Bridge SukiSU-Ultra's SuSFS v2 reboot ABI to the SuSFS v1.5.5 core used
+ * by Linux 4.9.  Legacy v1.5.5 userspace remains supported by the prctl
+ * bridge in KernelSU's LSM hook.
+ */
+#include <linux/errno.h>
+#include <linux/susfs.h>
+#include <linux/uaccess.h>
+
+struct ksu_susfs_version_v2 {
+	char version[SUSFS_MAX_VERSION_BUFSIZE];
+	int err;
+};
+
+struct ksu_susfs_features_v2 {
+	char features[SUSFS_ENABLED_FEATURES_SIZE];
+	int err;
+};
+
+struct ksu_susfs_variant_v2 {
+	char variant[SUSFS_MAX_VARIANT_BUFSIZE];
+	int err;
+};
+
+struct ksu_susfs_log_v2 {
+	u32 enabled;
+	int err;
+};
+
+struct ksu_susfs_toggle_v2 {
+	u32 enabled;
+	int err;
+};
+
+static inline void ksu_susfs_set_err(void __user *arg, size_t offset, int err)
+{
+	copy_to_user((char __user *)arg + offset, &err, sizeof(err));
+}
+
+static inline void ksu_susfs_add_sus_path(void __user **arg)
+{
+	/* v2 paths do not carry the inode required by v1.5.5. */
+	ksu_susfs_set_err(*arg, SUSFS_MAX_LEN_PATHNAME, -EOPNOTSUPP);
+}
+
+static inline void ksu_susfs_add_sus_kstat(void __user **arg)
+{
+	/* The v1.5.5 and v2 kstat layouts differ; use the legacy module tool. */
+	ksu_susfs_set_err(*arg, sizeof(struct st_susfs_sus_kstat), -EOPNOTSUPP);
+}
+
+static inline void ksu_susfs_update_sus_kstat(void __user **arg)
+{
+	ksu_susfs_add_sus_kstat(arg);
+}
+
+static inline void ksu_susfs_set_uname(void __user **arg)
+{
+	int err = susfs_set_uname((struct st_susfs_uname __user *)*arg);
+
+	ksu_susfs_set_err(*arg, ALIGN(sizeof(struct st_susfs_uname), sizeof(int)), err);
+}
+
+static inline void ksu_susfs_enable_log(void __user **arg)
+{
+	struct ksu_susfs_log_v2 info;
+
+	if (copy_from_user(&info, *arg, sizeof(info))) {
+		info.err = -EFAULT;
+	} else {
+		susfs_set_log(!!info.enabled);
+		info.err = 0;
+	}
+	copy_to_user(*arg, &info, sizeof(info));
+}
+
+static inline void ksu_susfs_set_cmdline(void __user **arg)
+{
+	/* v2 wraps the command line in a structure; v1.5.5 accepts a char array. */
+	int err = susfs_set_cmdline_or_bootconfig((char __user *)*arg);
+
+	ksu_susfs_set_err(*arg, SUSFS_FAKE_CMDLINE_OR_BOOTCONFIG_SIZE, err);
+}
+
+static inline void ksu_susfs_add_open_redirect(void __user **arg)
+{
+	/* v2 lacks the target inode required by the v1.5.5 implementation. */
+	ksu_susfs_set_err(*arg, SUSFS_MAX_LEN_PATHNAME * 2 + sizeof(u32), -EOPNOTSUPP);
+}
+
+static inline void ksu_susfs_hide_mounts(void __user **arg)
+{
+	struct ksu_susfs_toggle_v2 info;
+
+	if (copy_from_user(&info, *arg, sizeof(info)))
+		return;
+	/* v1.5.5 mount hiding is always enabled for marked app processes. */
+	info.err = info.enabled ? 0 : -EOPNOTSUPP;
+	copy_to_user(*arg, &info, sizeof(info));
+}
+
+static inline int ksu_susfs_append_feature(char *buffer, size_t size,
+					   size_t *used, const char *feature)
+{
+	size_t len = strlen(feature);
+
+	if (*used + len >= size)
+		return -ENOSPC;
+	memcpy(buffer + *used, feature, len);
+	*used += len;
+	return 0;
+}
+
+static inline void ksu_susfs_get_enabled_features(void __user **arg)
+{
+	struct ksu_susfs_features_v2 *info;
+	size_t used = 0;
+
+	info = kzalloc(sizeof(*info), GFP_KERNEL);
+	if (!info)
+		return;
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+	ksu_susfs_append_feature(info->features, sizeof(info->features), &used,
+				 "CONFIG_KSU_SUSFS_SUS_PATH\n");
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+	ksu_susfs_append_feature(info->features, sizeof(info->features), &used,
+				 "CONFIG_KSU_SUSFS_SUS_MOUNT\n");
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+	ksu_susfs_append_feature(info->features, sizeof(info->features), &used,
+				 "CONFIG_KSU_SUSFS_SUS_KSTAT\n");
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_OVERLAYFS
+	ksu_susfs_append_feature(info->features, sizeof(info->features), &used,
+				 "CONFIG_KSU_SUSFS_SUS_OVERLAYFS\n");
+#endif
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+	ksu_susfs_append_feature(info->features, sizeof(info->features), &used,
+				 "CONFIG_KSU_SUSFS_TRY_UMOUNT\n");
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_UNAME
+	ksu_susfs_append_feature(info->features, sizeof(info->features), &used,
+				 "CONFIG_KSU_SUSFS_SPOOF_UNAME\n");
+#endif
+#ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
+	ksu_susfs_append_feature(info->features, sizeof(info->features), &used,
+				 "CONFIG_KSU_SUSFS_ENABLE_LOG\n");
+#endif
+#ifdef CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS
+	ksu_susfs_append_feature(info->features, sizeof(info->features), &used,
+				 "CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS\n");
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+	ksu_susfs_append_feature(info->features, sizeof(info->features), &used,
+				 "CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG\n");
+#endif
+#ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
+	ksu_susfs_append_feature(info->features, sizeof(info->features), &used,
+				 "CONFIG_KSU_SUSFS_OPEN_REDIRECT\n");
+#endif
+	info->err = 0;
+	copy_to_user(*arg, info, sizeof(*info));
+	kfree(info);
+}
+
+static inline void ksu_susfs_show_variant(void __user **arg)
+{
+	struct ksu_susfs_variant_v2 info = { { 0 }, 0 };
+
+	strncpy(info.variant, SUSFS_VARIANT, sizeof(info.variant) - 1);
+	copy_to_user(*arg, &info, sizeof(info));
+}
+
+static inline void ksu_susfs_show_version(void __user **arg)
+{
+	struct ksu_susfs_version_v2 info = { { 0 }, 0 };
+
+	strncpy(info.version, SUSFS_VERSION, sizeof(info.version) - 1);
+	copy_to_user(*arg, &info, sizeof(info));
+}
+
+#define susfs_add_sus_path(arg) ksu_susfs_add_sus_path(arg)
+#define susfs_add_sus_path_loop(arg) ksu_susfs_add_sus_path(arg)
+#define susfs_set_hide_sus_mnts_for_non_su_procs(arg) ksu_susfs_hide_mounts(arg)
+#define susfs_add_sus_kstat(arg) ksu_susfs_add_sus_kstat(arg)
+#define susfs_update_sus_kstat(arg) ksu_susfs_update_sus_kstat(arg)
+#define susfs_set_uname(arg) ksu_susfs_set_uname(arg)
+#define susfs_enable_log(arg) ksu_susfs_enable_log(arg)
+#define susfs_set_cmdline_or_bootconfig(arg) ksu_susfs_set_cmdline(arg)
+#define susfs_add_open_redirect(arg) ksu_susfs_add_open_redirect(arg)
+#define susfs_add_sus_map(arg) ksu_susfs_set_err(*(arg), SUSFS_MAX_LEN_PATHNAME, -EOPNOTSUPP)
+#define susfs_set_avc_log_spoofing(arg) ksu_susfs_set_err(*(arg), sizeof(u32), -EOPNOTSUPP)
+#define susfs_get_enabled_features(arg) ksu_susfs_get_enabled_features(arg)
+#define susfs_show_variant(arg) ksu_susfs_show_variant(arg)
+#define susfs_show_version(arg) ksu_susfs_show_version(arg)
+#define susfs_start_sdcard_monitor_fn() do { } while (0)
+
+#endif /* KSU_SUSFS_KSU_COMPAT_H */
