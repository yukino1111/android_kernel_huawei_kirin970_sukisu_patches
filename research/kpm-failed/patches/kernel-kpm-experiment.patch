diff --git a/drivers/of/base.c b/drivers/of/base.c
index a4a2960d5..8f48cdbf7 100644
--- a/drivers/of/base.c
+++ b/drivers/of/base.c
@@ -45,6 +45,32 @@ static const char *of_stdout_options;
 
 struct kset *of_kset;
 
+static void __init of_par_disable_first_stage_avb(const char *path)
+{
+	struct device_node *np;
+	struct property *prop;
+
+	np = of_find_node_by_path(path);
+	if (!np)
+		return;
+
+	prop = of_find_property(np, "fsmgr_flags", NULL);
+	if (prop && prop->value && strstr(prop->value, "avb")) {
+		/*
+		 * The stock boot loader validates Huawei's private vbmeta format,
+		 * but modern AOSP libavb rejects that metadata when a custom kernel
+		 * changes verifiedbootstate from green to orange.  The device is
+		 * unlocked, so mount the immutable vendor/odm partitions directly
+		 * instead of attempting a second, incompatible first-stage check.
+		 */
+		prop->value = "wait";
+		prop->length = sizeof("wait");
+		pr_info("disabled incompatible first-stage AVB flag for %s\n", path);
+	}
+
+	of_node_put(np);
+}
+
 /*
  * Used to protect the of_aliases, to hold off addition of nodes to sysfs.
  * This mutex must be held whenever modifications are being made to the
@@ -202,9 +228,14 @@ int __of_attach_node_sysfs(struct device_node *np)
 void __init of_core_init(void)
 {
 	struct device_node *np;
+	struct device_node *android_np;
+	struct device_node *vbmeta_np;
+	int rc;
 
 	/* Create the kset, and register existing nodes */
 	mutex_lock(&of_mutex);
+	of_par_disable_first_stage_avb("/firmware/android/fstab/vendor");
+	of_par_disable_first_stage_avb("/firmware/android/fstab/odm");
 	of_kset = kset_create_and_add("devicetree", NULL, firmware_kobj);
 	if (!of_kset) {
 		mutex_unlock(&of_mutex);
@@ -213,6 +244,28 @@ void __init of_core_init(void)
 	}
 	for_each_of_allnodes(np)
 		__of_attach_node_sysfs(np);
+
+	/*
+	 * Kirin 970 firmware exposes the AVB partition list as
+	 * firmware/android/vbmeta_hisi/parts.  Modern Android first-stage init
+	 * reads the legacy firmware/android/vbmeta/parts path literally.  Keep
+	 * the firmware-owned node intact and provide the expected read-only
+	 * sysfs alias so early AVB setup can discover vbmeta, vendor and odm.
+	 */
+	android_np = of_find_node_by_path("/firmware/android");
+	vbmeta_np = android_np ? of_get_child_by_name(android_np, "vbmeta") : NULL;
+	if (android_np && !vbmeta_np) {
+		vbmeta_np = of_get_child_by_name(android_np, "vbmeta_hisi");
+		if (vbmeta_np) {
+			rc = sysfs_create_link(&android_np->kobj, &vbmeta_np->kobj,
+					       "vbmeta");
+			if (rc)
+				pr_warn("failed to create Android vbmeta DT alias: %d\n",
+					rc);
+		}
+	}
+	of_node_put(vbmeta_np);
+	of_node_put(android_np);
 	mutex_unlock(&of_mutex);
 
 	/* Symlink in /proc as required by userspace ABI */
