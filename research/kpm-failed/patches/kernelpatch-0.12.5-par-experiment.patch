+void clear_table_exec_kernel(uint64_t va)
+{
+    uint64_t pxd_bits = page_shift - 3;
+    uint64_t pxd_ptrs = 1u << pxd_bits;
+    uint64_t pxd_va = pgd_va;
+
+    /*
+     * A leaf PTE can be ROX while an ancestor table descriptor still has
+     * PXNTable/UXNTable set.  In that case instruction fetches fault even
+     * though a leaf-page dump looks executable.  Walk only the table path
+     * for this VA and let leaf PTEs retain their own W^X permissions.
+     */
+    for (int64_t lv = 4 - page_level; lv < 3; lv++) {
+        uint64_t pxd_shift = pxd_bits * (4 - lv) + 3;
+        uint64_t pxd_index = (va >> pxd_shift) & (pxd_ptrs - 1);
+        uint64_t *entry = (uint64_t *)(pxd_va + pxd_index * sizeof(uint64_t));
+        uint64_t desc = *entry;
+
+        if ((desc & PTE_TYPE_MASK) != PTE_TYPE_PAGE) {
+            log_boot("KPM table L%d is not a table: %llx\n", lv, desc);
+            return;
+        }
+
+        uint64_t exec_desc = desc & ~PTATTR_PXN & ~PTATTR_XN;
+        log_boot("KPM table L%d: %llx -> %llx\n", lv, desc, exec_desc);
+
+        /*
+         * Changing hierarchical execute permissions is a break-before-make
+         * update.  Merely overwriting PXNTable/UXNTable and invalidating the
+         * TLB afterwards can leave a CPU using the cached old table
+         * descriptor, which still makes an otherwise ROX leaf fault on an
+         * instruction fetch.
+         *
+         * The upper entries shared with the running KP text are already
+         * executable, so only the dedicated KPM-pool table entry reaches
+         * this path.
+         */
+        if (exec_desc != desc) {
+            *entry = 0;
+            dsb(ishst);
+            flush_tlb_all();
+
+            *entry = exec_desc;
+            dsb(ishst);
+            flush_tlb_all();
+        }
+
+        uint64_t table_pa = desc & (((1ul << (48 - page_shift)) - 1) << page_shift);
+        pxd_va = phys_to_virt(table_pa);
+    }
+
+    flush_tlb_all();
+}
+KP_EXPORT_SYMBOL(clear_table_exec_kernel);
